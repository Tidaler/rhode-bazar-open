<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.rhodebazar.frontend.controller.VenteController"
            prefWidth="1100" prefHeight="680">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="barre-application">
                <Button text="%vente.retour" styleClass="bouton-lien" onAction="#retourTableauDeBord"/>
                <Label text="%vente.title" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="12" right="20" bottom="6" left="20"/>
                </padding>
                <Label text="%vente.depot"/>
                <ComboBox fx:id="champDepot" prefWidth="160"/>
                <Label text="%vente.modePaiement"/>
                <ComboBox fx:id="champModePaiement" prefWidth="140"/>
                <Label text="%vente.client"/>
                <TextField fx:id="champClient" prefWidth="160"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="0" right="20" bottom="6" left="20"/>
                </padding>
                <Label text="%vente.scanner"/>
                <TextField fx:id="champScanner" promptText="%vente.scanner.prompt" prefWidth="220" onAction="#scannerCodeBarres"/>
                <Label text="%vente.scanner.aide" style="-fx-text-fill: gray; -fx-font-size: 11px;"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="6" right="20" bottom="12" left="20"/>
                </padding>
                <Label text="%vente.produit"/>
                <ComboBox fx:id="champProduit" prefWidth="220"/>
                <Label text="%vente.quantite"/>
                <Spinner fx:id="champQuantite" prefWidth="90" editable="true"/>
                <Button text="%vente.ajouterLigne" styleClass="bouton-principal" onAction="#ajouterAuPanier"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="16">
            <padding>
                <Insets top="0" right="20" bottom="20" left="20"/>
            </padding>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <TableView fx:id="tablePanier" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colonnePanierProduit" text="%vente.panier.produit" prefWidth="180"/>
                        <TableColumn fx:id="colonnePanierQuantite" text="%vente.panier.quantite" prefWidth="90"/>
                        <TableColumn fx:id="colonnePanierPrix" text="%vente.panier.prixUnitaire" prefWidth="110"/>
                        <TableColumn fx:id="colonnePanierMontant" text="%vente.panier.montant" prefWidth="110"/>
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="%vente.retirerLigne" styleClass="bouton-lien" onAction="#retirerLigneSelectionnee"/>
                    <Label fx:id="labelTotal" style="-fx-font-size: 16px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="%vente.enregistrer" styleClass="bouton-principal" onAction="#enregistrerVente"/>
                </HBox>
            </VBox>
            <VBox spacing="8" HBox.hgrow="ALWAYS">
                <Label text="%vente.historique.titre" styleClass="titre-ecran"/>
                <TableView fx:id="tableHistorique" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colonneHistoriqueNumero" text="%vente.historique.numero" prefWidth="90"/>
                        <TableColumn fx:id="colonneHistoriqueDate" text="%vente.historique.date" prefWidth="150"/>
                        <TableColumn fx:id="colonneHistoriqueClient" text="%vente.historique.client" prefWidth="120"/>
                        <TableColumn fx:id="colonneHistoriqueMode" text="%vente.historique.mode" prefWidth="110"/>
                        <TableColumn fx:id="colonneHistoriqueMontant" text="%vente.historique.montant" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>

</BorderPane>
