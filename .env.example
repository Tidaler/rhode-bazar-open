# Copier ce fichier en ".env" et renseigner des valeurs reelles avant "docker compose up".
RHODEBAZAR_DB_PASSWORD=changez-moi
RHODEBAZAR_DB_ROOT_PASSWORD=changez-moi-aussi
RHODEBAZAR_JWT_SECRET=changez-moi-cle-secrete-longue-et-aleatoire
RHODEBAZAR_ADMIN_PASSWORD=changez-moi-mot-de-passe-admin-initial

# Optionnel : active le resume IA (Claude) du reporting. Laisser vide pour
# desactiver cette fonctionnalite (le reporting local continue de fonctionner
# sans elle). Cle a obtenir sur https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modele et longueur de reponse par defaut (peuvent rester tels quels)
RHODEBAZAR_AI_MODEL=claude-opus-5
RHODEBAZAR_AI_MAX_TOKENS=1024
